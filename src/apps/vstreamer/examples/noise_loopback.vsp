# Bench: synthetic NV12 -> H.264 -> RTP -> UDP loopback -> decode -> display, one host.
# Needs an H.264 encoder and the MPP decoder; uses a desktop SDL window.

queue shown 2

pipeline tx
node noise noise_source size=1280x720 fps=30 format=nv12
node enc   h264_encoder size=1280x720 fps=30 gop=30 rc=cbr cbr=4000000
node pay   rtp_h264_pay fps=30 mtu=1400
node snd   stream_sender mtu=1400 max_datagram=1476 stream=127.0.0.1:5001
link noise -> enc -> pay -> snd

pipeline rx
node rcv   stream_receiver listen=127.0.0.1:5001 max_datagram=1476
node depay rtp_h264_depay fps=30
node dec   h264_decoder size=1280x720 fps=30 output_size_mode=stream
link rcv -> depay -> dec -> @shown

pipeline display
node screen sdl_sink
link @shown -> screen

enable snd
