menu "vstreamer IDF example"

config VSTREAMER_IDF_LIVE_TX
    bool "Live camera -> H.264 -> RTP -> stream_sender over Ethernet"
    default n
    help
        Skip loopback smoke tests; stream to CONFIG_VSTREAMER_RX_PEER after DHCP.

config VSTREAMER_RX_PEER
    string "Receiver host:port (stream_sender stream=)"
    default "192.168.253.106:21090"
    depends on VSTREAMER_IDF_LIVE_TX

config VSTREAMER_LIVE_TX_SECONDS
    int "Live stream duration (seconds)"
    default 120
    range 5 3600
    depends on VSTREAMER_IDF_LIVE_TX

endmenu
