--- a/port/src/esp_h264_cache.c
+++ b/port/src/esp_h264_cache.c
@@ -14,5 +14,17 @@ void esp_h264_cache_check_and_writeback(uint8_t *addr, uint32_t length)
 
 void esp_h264_cache_check_and_invalidate(uint8_t *addr, uint32_t length)
 {
-    esp_cache_msync(addr, length, ESP_CACHE_MSYNC_FLAG_DIR_M2C);
+    if (0 == length || NULL == addr)
+    {
+        return;
+    }
+    const uintptr_t align = 64U;
+    uintptr_t       start = (uintptr_t)addr & ~(align - 1U);
+    uintptr_t       end = (uintptr_t)addr + length;
+    end = (end + align - 1U) & ~(align - 1U);
+    if (end > start)
+    {
+        esp_cache_msync((void *)start, end - start, ESP_CACHE_MSYNC_FLAG_DIR_M2C);
+    }
 }
