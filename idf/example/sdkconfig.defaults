CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
# esp_video + sensor drivers outgrow the default 1 MB app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# app_main only starts the smoke-test thread.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# A datagram burst (an FEC block at video rate) overflows lwIP's default
# 6-datagram UDP receive queue and loses more shards than FEC can repair.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
# MIPI-CSI camera for esp32p4_csi_camera_src: OV5647 at 1080p30 RAW10, ISP with AE/AWB. The
# encoder is esp_h264 directly, so esp_video's own H.264 device stays off.
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ESP_VIDEO_ENABLE_HW_H264_VIDEO_DEVICE=n
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1920X1080_30FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1920X1080_30FPS=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_VSTREAMER_IDF_LIVE_TX=y
CONFIG_VSTREAMER_RX_PEER="192.168.253.106:21090"
CONFIG_VSTREAMER_LIVE_TX_SECONDS=0
# stream_sender pacing uses usleep on CPU0; don't trip IDLE task WDT during live TX.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# vs_send can pace/back up under 1080p load; 8s avoids false trips while still catching hangs.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=8
# Live TX: 1080p30 needs both cores at full speed (esp_h264 HW target ~33 ms/frame).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
